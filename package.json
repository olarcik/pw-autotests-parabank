{
  "name": "pw-auto-parabank",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose --profile tests down",
    "docker:logs": "docker compose logs -f --tail=200 parabank",
    "docker:test": "docker compose --profile tests up --build --attach e2e --exit-code-from e2e && npm run docker:down || (npm run docker:down && exit 1)",
    "test:host-docker": "npm run docker:up && playwright test",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "^1.61.1",
    "@qase/mcp-server": "^3.0.1",
    "@types/node": "^26.1.1",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "husky": "^9.1.7",
    "playwright-qase-reporter": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
