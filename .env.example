# Copy to .env and adjust. Never commit .env.
# Values set in the shell or CI win over .env; .env wins over env/<ENV>.env.

# Environment: local (Docker app, npm run docker:up) or demo (public site). App URLs live in env/<ENV>.env.
ENV=local

# Host port of the local Docker app (Compose only).
# If you change the port, also set BASE_URL=http://localhost:<port>/parabank here.
PARABANK_PORT=8080

# Qase TestOps reporting (QASE_MODE: testops | report | off). off = nothing is sent.
QASE_MODE=off
QASE_TESTOPS_PROJECT=
QASE_TESTOPS_API_TOKEN=
# Optional run name in Qase; a default name is used when empty.
QASE_TESTOPS_RUN_TITLE=
