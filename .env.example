# Copy to .env and adjust. Never commit .env.

# Environment name and tenant (src/common/data/setup.ts)
ENV=dev
TENANT=parabank

# Host port of the local Docker app; keep BASE_URL below in sync when you change it.
PARABANK_PORT=8080
# App URL for tests run on the host. Local Docker app (npm run docker:up); public demo: https://parabank.parasoft.com/parabank
# npm run docker:test ignores it and uses http://parabank:8080/parabank inside the Compose network.
BASE_URL=http://localhost:8080/parabank

# Credentials of existing users (GitHub secrets in CI). Leave empty unless a test needs them.
CLIENT_USERNAME=
CLIENT_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Qase TestOps reporting (QASE_MODE: testops | report | off). off = nothing is sent.
QASE_MODE=off
QASE_TESTOPS_PROJECT=
QASE_TESTOPS_API_TOKEN=
# Optional run name in Qase; a default name is used when empty.
QASE_TESTOPS_RUN_TITLE=
