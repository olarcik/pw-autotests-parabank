ENV=dev
TENANT=parabank
# Host port of the local Docker app; keep BASE_URL below in sync when you change it.
PARABANK_PORT=8080
# Local Docker app (npm run docker:up); public demo: https://parabank.parasoft.com/parabank
BASE_URL=http://localhost:8080/parabank
# Qase TestOps reporting (QASE_MODE: testops | report | off)
QASE_MODE=off
QASE_TESTOPS_PROJECT=
QASE_TESTOPS_API_TOKEN=